{
  "uid": "tpg-backup",
  "title": "Tanzu Postgres - Backup, WAL and restore",
  "description": "Backups by phase and type, age of the newest full and incremental backup, WAL archiving, retention and restores.",
  "tags": [
    "tanzu-postgres",
    "tpg"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Tanzu Postgres",
      "type": "dashboards",
      "tags": [
        "tpg"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tanzu_postgres_instance_state, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(tanzu_postgres_instance_state, cluster)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {},
        "sort": 1
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Instance",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tanzu_postgres_instance_state{cluster=~\"$cluster\"}, instance_name)",
          "refId": "instance"
        },
        "definition": "label_values(tanzu_postgres_instance_state{cluster=~\"$cluster\"}, instance_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Backups",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Hours since the newest successful full backup",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(time() - max by (cluster, instance_namespace, instance_name) (tanzu_postgres_backup_completed_timestamp{cluster=~\"$cluster\", instance_name=~\"$instance\", backup_type=\"full\"} and on (cluster, instance_namespace, backup_name) (tanzu_postgres_backup_phase{phase=\"Succeeded\"} == 1))) / 3600",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "The fleet schedule takes a full backup every Sunday (tpg-backup-full): more than 7 days (168 h) means a weekly full was missed.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 168
              },
              {
                "color": "red",
                "value": 192
              }
            ]
          },
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "hours"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Hours since the newest successful backup (any type)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(time() - max by (cluster, instance_namespace, instance_name) (tanzu_postgres_backup_completed_timestamp{cluster=~\"$cluster\", instance_name=~\"$instance\"} and on (cluster, instance_namespace, backup_name) (tanzu_postgres_backup_phase{phase=\"Succeeded\"} == 1))) / 3600",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "The tpg-no-recent-backup alert fires above 26 hours.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 26
              }
            ]
          },
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "hours"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Backups by phase and type",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, instance_name, backup_type, phase) (tanzu_postgres_backup_phase{cluster=~\"$cluster\", instance_name=~\"$instance\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "backups"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Backups completed in the last 24 hours",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (cluster, instance_name, backup_type) ((time() - tanzu_postgres_backup_completed_timestamp{cluster=~\"$cluster\", instance_name=~\"$instance\"}) < 86400)",
          "legendFormat": "{{cluster}}/{{instance_name}} {{backup_type}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "One full backup on Sunday and one incremental on the other days is the fleet schedule.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Backup workflow results (24h)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, instance_name, backup_type, result) (increase(argo_workflows_tpg_backup_result_total{cluster=~\"$cluster\", instance_name=~\"$instance\"}[24h]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "Results of the tpg-backup runs (CronWorkflows tpg-backup-full and tpg-backup-incr, and manual runs).",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "runs"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Retention workflow results (7d)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, instance_name, result) (increase(argo_workflows_tpg_backup_retention_result_total{cluster=~\"$cluster\", instance_name=~\"$instance\"}[7d]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "tpg-backup-retention expires whole chains older than retentionDays: EXPIRED, NOTHING_TO_EXPIRE, DRY_RUN.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "runs"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "WAL archiving",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "WAL archive failures (15m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (increase(pg_stat_archiver_failed_count{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[15m]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "WAL segments archived (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (increase(pg_stat_archiver_archived_count{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[1h]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Restores",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "title": "Restores by phase",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, instance_namespace, target_instance, phase) (tanzu_postgres_restore_phase{cluster=~\"$cluster\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "restores"
            }
          }
        }
      ]
    },
    {
      "id": 13,
      "title": "Restore workflow results (7d)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, instance_name, mode, result) (increase(argo_workflows_tpg_restore_result_total{cluster=~\"$cluster\", instance_name=~\"$instance\"}[7d]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "runs"
            }
          }
        }
      ]
    }
  ]
}
