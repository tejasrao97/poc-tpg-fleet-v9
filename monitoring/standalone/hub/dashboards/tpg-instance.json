{
  "uid": "tpg-instance",
  "title": "Tanzu Postgres - Instance overview",
  "description": "Per cluster and instance: availability, connections, throughput, cache, size, locks and the resources of the Postgres pods.",
  "tags": [
    "tanzu-postgres",
    "tpg"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Tanzu Postgres",
      "type": "dashboards",
      "tags": [
        "tpg"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tanzu_postgres_instance_state, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(tanzu_postgres_instance_state, cluster)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {},
        "sort": 1
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Instance",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tanzu_postgres_instance_state{cluster=~\"$cluster\"}, instance_name)",
          "refId": "instance"
        },
        "definition": "label_values(tanzu_postgres_instance_state{cluster=~\"$cluster\"}, instance_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Availability",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Instance state (operator)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tanzu_postgres_instance_state{cluster=~\"$cluster\", instance_name=~\"$instance\"} == 1",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "status.currentState of every Postgres object (kube-state-metrics custom resource metrics).",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "pod": true,
              "service": true,
              "endpoint": true,
              "container": true,
              "namespace": true,
              "customresource_group": true,
              "customresource_kind": true,
              "customresource_version": true
            },
            "renameByName": {
              "state": "currentState"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Exporter up per pod",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, postgres_instance, pod) (up{cluster=~\"$cluster\", postgres_instance=~\"$instance\"})",
          "legendFormat": "{{cluster}}/{{pod}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "1 when the postgres-exporter sidecar of the pod is scraped. The tpg-exporter-down alert fires after 5 minutes at 0.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "title": "Postgres reachable (pg_up)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, postgres_instance, pod) (pg_up{cluster=~\"$cluster\", postgres_instance=~\"$instance\"})",
          "legendFormat": "{{cluster}}/{{pod}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Connections and throughput",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Connections used (% of max_connections)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum by (cluster, postgres_instance) (pg_stat_activity_count{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}) / max by (cluster, postgres_instance) (pg_settings_max_connections{cluster=~\"$cluster\", postgres_instance=~\"$instance\"})",
          "legendFormat": "{{cluster}}/{{postgres_instance}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "The tpg-connections-high alert fires above 80% for 10 minutes.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Connections by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance, state) (pg_stat_activity_count{cluster=~\"$cluster\", postgres_instance=~\"$instance\"})",
          "legendFormat": "{{cluster}}/{{postgres_instance}} {{state}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Transactions per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (rate(pg_stat_database_xact_commit{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}} commit",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (rate(pg_stat_database_xact_rollback{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}} rollback",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (rate(pg_stat_database_blks_hit{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[5m])) / clamp_min(sum by (cluster, postgres_instance) (rate(pg_stat_database_blks_hit{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[5m])) + sum by (cluster, postgres_instance) (rate(pg_stat_database_blks_read{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[5m])), 1)",
          "legendFormat": "{{cluster}}/{{postgres_instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Rows per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (rate(pg_stat_database_tup_fetched{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}} fetched",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (rate(pg_stat_database_tup_inserted{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}} inserted",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (rate(pg_stat_database_tup_updated{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}} updated",
          "instant": false,
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (rate(pg_stat_database_tup_deleted{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}} deleted",
          "instant": false,
          "range": true
        }
      ],
      "description": "Rows per second, summed over the databases of the instance.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Storage, locks and long transactions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "title": "Database size",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance, datname) (pg_database_size_bytes{cluster=~\"$cluster\", postgres_instance=~\"$instance\", datname!~\"template.*\"})",
          "legendFormat": "{{cluster}}/{{postgres_instance}} {{datname}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Locks by mode",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 34,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance, mode) (pg_locks_count{cluster=~\"$cluster\", postgres_instance=~\"$instance\"})",
          "legendFormat": "{{cluster}}/{{postgres_instance}} {{mode}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Deadlocks (15m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 34,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (increase(pg_stat_database_deadlocks{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[15m]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Longest running transaction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, postgres_instance) (pg_stat_activity_max_tx_duration{cluster=~\"$cluster\", postgres_instance=~\"$instance\"})",
          "legendFormat": "{{cluster}}/{{postgres_instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Volume usage (data and WAL)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, namespace, persistentvolumeclaim) (kubelet_volume_stats_used_bytes{cluster=~\"$cluster\", namespace=~\"pg-($instance)\"}) / max by (cluster, namespace, persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{cluster=~\"$cluster\", namespace=~\"pg-($instance)\"})",
          "legendFormat": "{{cluster}} {{persistentvolumeclaim}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "row",
      "title": "Postgres pods",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 18,
      "title": "CPU per pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, namespace, pod) (rate(container_cpu_usage_seconds_total{cluster=~\"$cluster\", namespace=~\"pg-($instance)\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{cluster}}/{{pod}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "CPU cores used (rate of container_cpu_usage_seconds_total).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "title": "Memory per pod (working set)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 51,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, namespace, pod) (container_memory_working_set_bytes{cluster=~\"$cluster\", namespace=~\"pg-($instance)\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{cluster}}/{{pod}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Container restarts (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 51,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, namespace, pod) (increase(kube_pod_container_status_restarts_total{cluster=~\"$cluster\", namespace=~\"pg-($instance)\"}[1h]))",
          "legendFormat": "{{cluster}}/{{pod}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    }
  ]
}
