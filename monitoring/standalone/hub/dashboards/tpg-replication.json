{
  "uid": "tpg-replication",
  "title": "Tanzu Postgres - Replication and HA",
  "description": "Primary and standby roles, replication lag, replicas ready against desired, and WAL archiving.",
  "tags": [
    "tanzu-postgres",
    "tpg"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Tanzu Postgres",
      "type": "dashboards",
      "tags": [
        "tpg"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tanzu_postgres_instance_state, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(tanzu_postgres_instance_state, cluster)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {},
        "sort": 1
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Instance",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tanzu_postgres_instance_state{cluster=~\"$cluster\"}, instance_name)",
          "refId": "instance"
        },
        "definition": "label_values(tanzu_postgres_instance_state{cluster=~\"$cluster\"}, instance_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Roles and replicas",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Role per pod (1 = replica, 0 = primary)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, postgres_instance, pod) (pg_replication_is_replica{cluster=~\"$cluster\", postgres_instance=~\"$instance\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "pg_replication_is_replica from the exporter: 0 on the primary, 1 on a standby or read replica.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "is_replica"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Pods ready vs desired",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, namespace, statefulset) (kube_statefulset_status_replicas_ready{cluster=~\"$cluster\", namespace=~\"pg-($instance)\"})",
          "legendFormat": "ready",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, namespace, statefulset) (kube_statefulset_replicas{cluster=~\"$cluster\", namespace=~\"pg-($instance)\"})",
          "legendFormat": "desired",
          "instant": true,
          "range": false
        }
      ],
      "description": "The tpg-replicas-below-desired alert fires when ready stays below desired for 10 minutes.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "ready",
              "Value #B": "desired"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Desired read replicas (spec)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, instance_name) (tanzu_postgres_instance_read_replicas{cluster=~\"$cluster\", instance_name=~\"$instance\"})",
          "legendFormat": "{{cluster}}/{{instance_name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Replication lag",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Replication lag (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, postgres_instance, pod) (pg_replication_lag_seconds{cluster=~\"$cluster\", postgres_instance=~\"$instance\"})",
          "legendFormat": "{{cluster}}/{{pod}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "The tpg-replication-lag alert fires above 30 seconds for 5 minutes.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "WAL archiving",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "title": "WAL segments archived (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (increase(pg_stat_archiver_archived_count{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[1h]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "WAL archive failures (15m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, postgres_instance) (increase(pg_stat_archiver_failed_count{cluster=~\"$cluster\", postgres_instance=~\"$instance\"}[15m]))",
          "legendFormat": "{{cluster}}/{{postgres_instance}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "The tpg-wal-archiving-failing alert fires on any failure: point-in-time recovery is at risk.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Pod restarts (24h)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, pod) (increase(kube_pod_container_status_restarts_total{cluster=~\"$cluster\", namespace=~\"pg-($instance)\"}[24h]))",
          "legendFormat": "{{cluster}}/{{pod}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "A failover restarts or replaces pods; a count that keeps growing points at a crash loop.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
