{
  "uid": "tpg-replicas-below-desired",
  "title": "Postgres pod replicas below desired",
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "relativeTimeRange": {
        "from": 900,
        "to": 0
      },
      "datasourceUid": "${DATASOURCE_UID}",
      "model": {
        "refId": "A",
        "expr": "max by (cluster, namespace, statefulset) (kube_statefulset_replicas{namespace=~\"pg-.*\"}) - max by (cluster, namespace, statefulset) (kube_statefulset_status_replicas_ready{namespace=~\"pg-.*\"})",
        "instant": true,
        "range": false,
        "intervalMs": 60000,
        "maxDataPoints": 43200
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "settings": {
          "mode": "dropNN"
        }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                0
              ]
            }
          }
        ]
      }
    }
  ],
  "noDataState": "OK",
  "execErrState": "Error",
  "for": "10m",
  "labels": {
    "severity": "warning"
  },
  "annotations": {
    "summary": "{{ $labels.cluster }}/{{ $labels.statefulset }} has fewer ready pods than desired"
  },
  "folderUID": "tpg-postgres",
  "ruleGroup": "tpg-postgres",
  "orgID": 1
}
