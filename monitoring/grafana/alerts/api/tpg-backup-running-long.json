{
  "uid": "tpg-backup-running-long",
  "title": "Postgres backup running too long",
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "relativeTimeRange": {
        "from": 900,
        "to": 0
      },
      "datasourceUid": "${DATASOURCE_UID}",
      "model": {
        "refId": "A",
        "expr": "max by (cluster, instance_namespace, instance_name, backup_name) (tanzu_postgres_backup_phase{phase=\"Running\"})",
        "instant": true,
        "range": false,
        "intervalMs": 60000,
        "maxDataPoints": 43200
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "settings": {
          "mode": "dropNN"
        }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                0
              ]
            }
          }
        ]
      }
    }
  ],
  "noDataState": "OK",
  "execErrState": "Error",
  "for": "3h",
  "labels": {
    "severity": "warning"
  },
  "annotations": {
    "summary": "Backup {{ $labels.backup_name }} on {{ $labels.cluster }} has been running for more than 3 hours"
  },
  "folderUID": "tpg-postgres",
  "ruleGroup": "tpg-postgres",
  "orgID": 1
}
